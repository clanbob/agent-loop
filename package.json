{
  "name": "agent-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for iterative building and review with Antigravity, Claude Code and Codex.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "app": "node scripts/build-app.mjs && electron .",
    "app:build": "node scripts/build-app.mjs",
    "ui:preview": "vite --config vite.config.ts",
    "loop": "node src/cli.ts run",
    "resume": "node src/cli.ts resume",
    "runs": "node src/cli.ts runs",
    "export": "node src/cli.ts export",
    "check": "node src/cli.ts check",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "node scripts/build-app.mjs && electron-builder --win",
    "dist:mac": "node scripts/build-app.mjs && electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  },
  "main": "dist/app/main.cjs",
  "productName": "Agent Loop",
  "author": "Agent Loop",
  "build": {
    "appId": "local.agentloop.app",
    "productName": "Agent Loop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "prompts/**/*",
      "schemas/**/*",
      "build/icon.*",
      "agentloop.config.json",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Loop",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Agent-Loop-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Agent-Loop-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "artifactName": "Agent-Loop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Agent Loop"
    }
  }
}
